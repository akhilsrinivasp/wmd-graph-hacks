# Local FalkorDB (docker compose) needs nothing. For FalkorDB Cloud, set:
# FALKORDB_URL=redis://USER:PASSWORD@HOST:PORT
# Optional LLM for free-text orders, pharmacist briefs and policy answers.
# Claude:
# ANTHROPIC_API_KEY=sk-ant-...
# or Gemini (free tier available from Google AI Studio):
# GEMINI_API_KEY=...
# Force one when both are set: COMPOUNDER_LLM=claude | gemini
